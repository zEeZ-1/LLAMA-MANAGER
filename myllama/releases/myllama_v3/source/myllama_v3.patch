diff --git a/ggml/src/ggml-pipeline.h b/ggml/src/ggml-pipeline.h
new file mode 100644
index 0000000..bea1db2
--- /dev/null
+++ b/ggml/src/ggml-pipeline.h
@@ -0,0 +1,137 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <cstddef>
+#include <utility>
+#include <vector>
+
+// Single-owner control state. Device completion and boundary visibility are reported separately.
+class ggml_pipeline_queue {
+public:
+    struct output_row {
+        uint64_t request;  // includes the service slot generation
+        uint32_t row;
+    };
+    struct task {
+        uint64_t block;
+        size_t rank;
+    };
+    enum class admission { accepted, duplicate, full, unsupported };
+    struct budget { size_t blocks, tokens; };
+
+    ggml_pipeline_queue(size_t ranks, size_t window, size_t token_limit)
+        : ready(ranks), window(window), token_limit(token_limit) {}
+
+    budget capacity() const { return {window - blocks.size(), token_limit - tokens}; }
+    bool drained() const { return blocks.empty(); }
+
+    // Block IDs are positive and strictly increasing within a scheduling session.
+    admission try_admit(uint64_t id, size_t count, std::vector<output_row> outputs = {}) {
+        if (!id || !count || count > token_limit || ready.empty()) {
+            return admission::unsupported;
+        }
+        if (id <= last_id) {
+            return admission::duplicate;
+        }
+        if (blocks.size() == window || count > capacity().tokens) {
+            return admission::full;
+        }
+        blocks.push_back({id, count, 0, state::ready, std::move(outputs)});
+        ready.front().push_back(id);
+        last_id = id;
+        tokens += count;
+        return admission::accepted;
+    }
+
+    bool submit(size_t rank, task & result) {
+        if (rank >= ready.size() || ready[rank].empty()) {
+            return false;
+        }
+        const uint64_t id = ready[rank].front();
+        // A late transfer of an older block must not reorder recurrent updates on this rank.
+        for (const auto & earlier : blocks) {
+            if (earlier.id >= id) {
+                break;
+            }
+            if (earlier.rank < rank || (earlier.rank == rank && earlier.phase == state::ready)) {
+                return false;
+            }
+        }
+        auto it = find(id);
+        ready[rank].pop_front();
+        it->phase = state::submitted;
+        result = {id, rank};
+        return true;
+    }
+
+    bool produced(task t) {
+        auto it = find(t.block);
+        if (it == blocks.end() || it->rank != t.rank || it->phase != state::submitted) {
+            return false;
+        }
+        it->phase = state::transferring;
+        return true;
+    }
+
+    // The executor may also signal when visibility is ordered on the consumer stream.
+    bool visible(task t) {
+        auto it = find(t.block);
+        if (it == blocks.end() || it->rank != t.rank || it->phase != state::transferring) {
+            return false;
+        }
+        if (++it->rank == ready.size()) {
+            it->phase = state::output;
+        } else {
+            it->phase = state::ready;
+            auto & queue = ready[it->rank];
+            queue.insert(std::upper_bound(queue.begin(), queue.end(), t.block), t.block);
+        }
+        return true;
+    }
+
+    void cancel(uint64_t request) {
+        for (auto & b : blocks) {
+            auto & rows = b.outputs;
+            rows.erase(std::remove_if(rows.begin(), rows.end(), [=](const output_row & r) {
+                return r.request == request;
+            }), rows.end());
+        }
+    }
+    bool take_output(uint64_t id, std::vector<output_row> & result) {
+        auto it = find(id);
+        if (it == blocks.end() || it->phase != state::output) {
+            return false;
+        }
+        result = std::move(it->outputs);
+        it->phase = state::held;
+        return true;
+    }
+    bool release(uint64_t id) {
+        auto it = find(id);
+        if (it == blocks.end() || it->phase != state::held) {
+            return false;
+        }
+        tokens -= it->tokens;
+        blocks.erase(it);
+        return true;
+    }
+
+private:
+    enum class state { ready, submitted, transferring, output, held };
+    struct block {
+        uint64_t id;
+        size_t tokens, rank;
+        state phase;
+        std::vector<output_row> outputs;
+    };
+    std::deque<block>::iterator find(uint64_t id) {
+        return std::find_if(blocks.begin(), blocks.end(), [=](const block & b) { return b.id == id; });
+    }
+    std::vector<std::deque<uint64_t>> ready;
+    std::deque<block> blocks;
+    size_t window, token_limit;
+    uint64_t last_id = 0;
+    size_t tokens = 0;
+};
diff --git a/ggml/src/ggml-rpc/mask-rows.h b/ggml/src/ggml-rpc/mask-rows.h
new file mode 100644
index 0000000..d187ae9
--- /dev/null
+++ b/ggml/src/ggml-rpc/mask-rows.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+template<typename T>
+static bool rpc_pack_mask(const void * data, size_t rows, size_t cols, T neg_inf, std::vector<uint32_t> & limits) {
+    auto * p = static_cast<const uint8_t *>(data);
+    limits.reserve(rows);
+    for (size_t r = 0; r < rows; ++r) {
+        size_t i = 0;
+        T value;
+        for (; i < cols; ++i) {
+            memcpy(&value, p + i*sizeof(T), sizeof(T));
+            if (value != 0) { break; }
+        }
+        limits.push_back(static_cast<uint32_t>(i));
+        for (; i < cols; ++i) {
+            memcpy(&value, p + i*sizeof(T), sizeof(T));
+            if (value != neg_inf) { return false; }
+        }
+        p += cols*sizeof(T);
+    }
+    return true;
+}
+
+template<typename T>
+static bool rpc_unpack_mask(const std::vector<uint32_t> & limits, size_t cols, T neg_inf, uint8_t * out) {
+    for (auto prefix : limits) {
+        if (prefix > cols) { return false; }
+        memset(out, 0, prefix * sizeof(T));
+        for (size_t j = prefix; j < cols; ++j) {
+            memcpy(out + j*sizeof(T), &neg_inf, sizeof(T));
+        }
+        out += cols*sizeof(T);
+    }
+    return true;
+}
diff --git a/tests/test-rpc-prefill-pipeline.cpp b/tests/test-rpc-prefill-pipeline.cpp
new file mode 100644
index 0000000..ba00628
--- /dev/null
+++ b/tests/test-rpc-prefill-pipeline.cpp
@@ -0,0 +1,136 @@
+#include "../ggml/src/ggml-pipeline.h"
+#include "../ggml/src/ggml-rpc/mask-rows.h"
+#include "../ggml/src/ggml-backend-impl.h"
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::abort(); } } while (false)
+
+template<typename T>
+static void test_mask_rows(T neg_inf) {
+    const std::array<T, 9> mask = {neg_inf, neg_inf, neg_inf, 0, neg_inf, neg_inf, 0, 0, 0};
+    std::vector<uint32_t> limits;
+    CHECK(rpc_pack_mask(mask.data(), 3, 3, neg_inf, limits));
+    CHECK((limits == std::vector<uint32_t>{0, 1, 3}));
+    std::array<T, 9> restored;
+    CHECK(rpc_unpack_mask(limits, 3, neg_inf, reinterpret_cast<uint8_t *>(restored.data())));
+    CHECK(mask == restored);
+    limits[1] = 4;
+    CHECK(!rpc_unpack_mask(limits, 3, neg_inf, reinterpret_cast<uint8_t *>(restored.data())));
+    restored = mask;
+    restored[1] = 0;
+    limits.clear();
+    CHECK(!rpc_pack_mask(restored.data(), 3, 3, neg_inf, limits));
+}
+
+static void test_queue() {
+    ggml_pipeline_queue q(3, 2, 128);
+    using result = ggml_pipeline_queue::admission;
+    using task = ggml_pipeline_queue::task;
+    CHECK(q.try_admit(0, 80) == result::unsupported);
+    CHECK(q.try_admit(1, 129) == result::unsupported);
+    CHECK(q.try_admit(1, 80, {{10, 1}, {20, 3}}) == result::accepted);
+    CHECK(q.try_admit(2, 64) == result::full);
+    CHECK(q.try_admit(1, 80) == result::duplicate);
+    CHECK(q.try_admit(2, 48, {{21, 4}}) == result::accepted);
+    CHECK(q.capacity().blocks == 0 && q.capacity().tokens == 0);
+    task a, b;
+    CHECK(q.submit(0, a) && a.block == 1);
+    CHECK(q.submit(0, b) && b.block == 2);
+    CHECK(!q.submit(1, a));
+    CHECK(!q.drained());
+    // The second network read completes first.
+    CHECK(q.produced(b) && q.visible(b));
+    CHECK(!q.submit(1, b));
+    CHECK(q.produced(a) && q.visible(a));
+    CHECK(!q.visible(a));
+    q.cancel(10);
+    for (size_t r = 1; r < 3; ++r) {
+        CHECK(q.submit(r, a) && a.block == 1);
+        CHECK(q.submit(r, b) && b.block == 2);
+        CHECK(q.produced(a) && q.visible(a));
+        CHECK(q.produced(b) && q.visible(b));
+    }
+    std::vector<ggml_pipeline_queue::output_row> rows;
+    CHECK(q.take_output(1, rows) && rows.size() == 1 && rows[0].request == 20 && rows[0].row == 3);
+    CHECK(!q.take_output(1, rows) && !q.drained());
+    CHECK(q.release(1));
+    CHECK(q.try_admit(3, 80) == result::accepted);
+    CHECK(!q.produced(a) && !q.visible(a));
+    CHECK(q.take_output(2, rows) && rows.size() == 1 && rows.front().request == 21);
+    CHECK(q.release(2));
+    for (size_t r = 0; r < 3; ++r) {
+        CHECK(q.submit(r, a) && a.block == 3);
+        CHECK(q.produced(a) && q.visible(a));
+    }
+    CHECK(q.take_output(3, rows) && q.release(3) && q.drained());
+}
+
+static void test_graphs(size_t count) {
+    std::array<ggml_backend_t, 3> backends;
+    for (auto & backend : backends) {
+        backend = ggml_backend_cpu_init();
+        ggml_backend_cpu_set_n_threads(backend, 1);
+    }
+    // Distinct host buffer types keep the scheduler's priority pass from folding all
+    // three CPU instances into one split. The kernels still run on real ggml tensors.
+    std::array<ggml_backend_buffer_type, 3> types;
+    std::array<ggml_backend_buffer_type_t, 3> bufts;
+    for (size_t r = 0; r < backends.size(); ++r) {
+        types[r] = *ggml_backend_cpu_buffer_type();
+        bufts[r] = &types[r];
+    }
+    std::vector<ggml_context *> ctx(count);
+    std::vector<ggml_backend_sched_t> plans(count);
+    std::vector<ggml_tensor *> out(count);
+    for (size_t b = 0; b < count; ++b) {
+        ctx[b] = ggml_init({1024*1024, nullptr, true});
+        plans[b] = ggml_backend_sched_new(backends.data(), bufts.data(), 3, 64, false, true);
+        auto input = ggml_new_tensor_1d(ctx[b], GGML_TYPE_F32, 5);
+        ggml_set_input(input);
+        auto x = input;
+        for (auto backend : backends) {
+            x = ggml_scale(ctx[b], x, 2.0f);
+            ggml_backend_sched_set_tensor_backend(plans[b], x, backend);
+        }
+        out[b] = x;
+        ggml_set_output(x);
+        auto graph = ggml_new_graph_custom(ctx[b], 64, false);
+        ggml_build_forward_expand(graph, x);
+        CHECK(ggml_backend_sched_alloc_graph(plans[b], graph));
+        CHECK(ggml_backend_sched_get_n_splits(plans[b]) == 3);
+        float values[5];
+        for (size_t i = 0; i < 5; ++i) { values[i] = float(10*b+i); }
+        ggml_backend_tensor_set(input, values, 0, sizeof(values));
+    }
+    ggml_backend_sched_t duplicate[2] = {plans[0], plans[0]};
+    CHECK(ggml_backend_sched_graph_compute_window(duplicate, 2) == GGML_STATUS_FAILED);
+    CHECK(ggml_backend_sched_graph_compute_window(nullptr, count) == GGML_STATUS_FAILED);
+    CHECK(ggml_backend_sched_graph_compute_window(plans.data(), count) == GGML_STATUS_SUCCESS);
+    for (size_t b = 0; b < count; ++b) {
+        float values[5];
+        ggml_backend_tensor_get(out[b], values, 0, sizeof(values));
+        for (size_t i = 0; i < 5; ++i) { CHECK(values[i] == 8*float(10*b+i)); }
+        ggml_backend_sched_free(plans[b]);
+        ggml_free(ctx[b]);
+    }
+    for (auto backend : backends) {
+        ggml_backend_free(backend);
+    }
+}
+
+int main() {
+    test_mask_rows<uint16_t>(0xfc00u);
+    test_mask_rows<uint32_t>(0xff800000u);
+    test_queue();
+    test_graphs(2);
+    test_graphs(3);
+    test_graphs(5);
+    test_graphs(8);
+    std::puts("queue ordering, backpressure, cancellation, late events and bounded multi-block ggml graphs passed");
+}
